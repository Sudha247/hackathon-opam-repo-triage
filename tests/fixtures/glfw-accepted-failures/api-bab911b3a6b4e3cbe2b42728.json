d/repos", "events_url": "https://api.github.com/users/SylvainBoilard/events{/privacy}", "received_events_url": "https://api.github.com/users/SylvainBoilard/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "parents": [{"sha": "1fe43ad351a4f555c9b9e50093b423050be7de2b", "url": "https://api.github.com/repos/ocaml/opam-repository/commits/1fe43ad351a4f555c9b9e50093b423050be7de2b", "html_url": "https://github.com/ocaml/opam-repository/commit/1fe43ad351a4f555c9b9e50093b423050be7de2b"}]}], "files": [{"sha": "320138610dcd864a3010d6424a1ab5051270aa68", "filename": "packages/conf-glfw3/conf-glfw3.3/opam", "status": "added", "additions": 36, "deletions": 0, "changes": 36, "blob_url": "https://github.com/ocaml/opam-repository/blob/bac9c3858cff51b3d7c9a6f6990799bbe7582c01/packages%2Fconf-glfw3%2Fconf-glfw3.3%2Fopam", "raw_url": "https://github.com/ocaml/opam-repository/raw/bac9c3858cff51b3d7c9a6f6990799bbe7582c01/packages%2Fconf-glfw3%2Fconf-glfw3.3%2Fopam", "contents_url": "https://api.github.com/repos/ocaml/opam-repository/contents/packages%2Fconf-glfw3%2Fconf-glfw3.3%2Fopam?ref=bac9c3858cff51b3d7c9a6f6990799bbe7582c01", "patch": "@@ -0,0 +1,36 @@\n+opam-version: \"2.0\"\n+synopsis: \"Virtual package relying on a GLFW3 system installation\"\n+description: \"This package can only install if libglfw3 is installed on the system.\"\n+maintainer: \"Sylvain BOILARD <boilard@crans.org>\"\n+authors: \"Sylvain BOILARD <boilard@crans.org>\"\n+homepage: \"http://www.glfw.org\"\n+bug-reports: \"https://github.com/ocaml/opam-repository/issues\"\n+license: \"Zlib\"\n+flags: conf\n+build: [\"pkg-config\" \"--print-errors\" \"--exists\" \"glfw3\"]\n+depends: [\n+  \"conf-pkg-config\" {build}\n+]\n+depexts: [\n+  [\"libglfw3-dev\"] {os-family = \"debian\"}\n+  [\"libglfw3-dev\"] {os-family = \"ubuntu\"}\n+  [\"glfw-devel\" \"epel-release\" \"mesa-libGL-devel\"]\n+    {os-distribution = \"centos\"}\n+  [\"glfw-devel\" \"mesa-libGL-devel\"] {os-distribution = \"rhel\"}\n+  [\"glfw-devel\" \"mesa-libGL-devel\"] {os-family = \"fedora\"}\n+  [\"lib64glfw-devel\" \"mesagl-devel\"] {os-distribution = \"mageia\"}\n+  [\"libglfw-devel\" \"Mesa-libGL-devel\"] {os-family = \"suse\"}\n+  [\"glfw-devel\" \"Mesa-libGL-devel\"] {os-family = \"opensuse\"}\n+  [\"glfw-dev\"] {os-family = \"alpine\"}\n+  [\"glfw\"] {os-family = \"arch\"}\n+  [\"glfw\"] {os = \"macos\" & os-distribution = \"homebrew\"}\n+  [\"glfw\" \"libglvnd\"] {os = \"freebsd\"}\n+  [\"mingw-w64-x86_64-glfw\"] {os-distribution = \"msys2\"}\n+]\n+x-ci-accept-failures: [\n+  # no glfw package available\n+  \"oraclelinux-7\"\n+  \"oraclelinux-8\"\n+  \"cygwin\"\n+]\n+x-maintenance-intent: [\"(latest)\"]"}, {"sha": "f2c438c8ac82a8ffc986c8b543f402271124a0d1", "filename": "packages/glfw-ocaml/glfw-ocaml.3.4/opam", "status": "added", "additions": 34, "deletions": 0, "changes": 34, "blob_url": "https://github.com/ocaml/opam-repository/blob/bac9c3858cff51b3d7c9a6f6990799bbe7582c01/packages%2Fglfw-ocaml%2Fglfw-ocaml.3.4%2Fopam", "raw_url": "https://github.com/ocaml/opam-repository/raw/bac9c3858cff51b3d7c9a6f6990799bbe7582c01/packages%2Fglfw-ocaml%2Fglfw-ocaml.3.4%2Fopam", "contents_url": "https://api.github.com/repos/ocaml/opam-repository/contents/packages%2Fglfw-ocaml%2Fglfw-ocaml.3.4%2Fopam?ref=bac9c3858cff51b3d7c9a6f6990799bbe7582c01", "patch": "@@ -0,0 +1,34 @@\n+opam-version: \"2.0\"\n+synopsis: \"A GLFW binding for OCaml\"\n+maintainer: \"Sylvain BOILARD <boilard@crans.org>\"\n+authors: \"Sylvain BOILARD <boilard@crans.org>\"\n+license: \"Zlib\"\n+homepage: \"https://github.com/SylvainBoilard/GLFW-OCaml\"\n+bug-reports: \"https://github.com/SylvainBoilard/GLFW-OCaml/issues\"\n+depends: [\n+  \"conf-glfw3\"\n+  \"base-bigarray\"\n+  \"dune\" {>= \"3.1\"}\n+  \"dune-configurator\"\n+  \"conf-pkg-config\" {build}\n+  \"ocaml\" {>= \"4.03.0\"}\n+]\n+x-ci-accept-failures: [\n+  # default version of this library is too old\n+  \"debian-12\"\n+  \"ubuntu-22.04\"\n+  \"ubuntu-24.04