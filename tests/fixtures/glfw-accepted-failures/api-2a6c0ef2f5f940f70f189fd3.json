[{"sha": "7f0b7343c2cd58952ac9e0beabf1bc35209ca970", "node_id": "C_kwDOAETL7doAKDdmMGI3MzQzYzJjZDU4OTUyYWM5ZTBiZWFiZjFiYzM1MjA5Y2E5NzA", "commit": {"author": {"name": "Antonin D\u00e9cimo", "email": "antonin@tarides.com", "date": "2025-05-14T18:15:44Z"}, "committer": {"name": "Antonin D\u00e9cimo", "email": "antonin@tarides.com", "date": "2025-05-14T18:15:44Z"}, "message": "Switch from os-distribution = \"fedora\" to os-family = \"fedora\"\n\nFedora Asahi Remix is a port of Fedora to Apple ARM64 machines.\nopam 2.3 reports:\n\n    $ opam var\n    os                linux               # Inferred from system\n    os-distribution   fedora-asahi-remix  # Inferred from system\n    os-family         fedora              # Inferred from system\n\nThe packages are shared with Fedora, but the distribution is\ndifferent. The os-family is shared, that's \"fedora\"!", "tree": {"sha": "94816dbafaad78224885c951ebaeb66ce9448d7a", "url": "https://api.github.com/repos/ocaml/opam-repository/git/trees/94816dbafaad78224885c951ebaeb66ce9448d7a"}, "url": "https://api.github.com/repos/ocaml/opam-repository/git/commits/7f0b7343c2cd58952ac9e0beabf1bc35209ca970", "comment_count": 0, "verification": {"verified": false, "reason": "unsigned", "signature": null, "payload": null, "verified_at": null}}, "url": "https://api.github.com/repos/ocaml/opam-repository/commits/7f0b7343c2cd58952ac9e0beabf1bc35209ca970", "html_url": "https://github.com/ocaml/opam-repository/commit/7f0b7343c2cd58952ac9e0beabf1bc35209ca970", "comments_url": "https://api.github.com/repos/ocaml/opam-repository/commits/7f0b7343c2cd58952ac9e0beabf1bc35209ca970/comments", "author": {"login": "MisterDA", "id": 1773581, "node_id": "MDQ6VXNlcjE3NzM1ODE=", "avatar_url": "https://avatars.githubusercontent.com/u/1773581?v=4", "gravatar_id": "", "url": "https://api.github.com/users/MisterDA", "html_url": "https://github.com/MisterDA", "followers_url": "https://api.github.com/users/MisterDA/followers", "following_url": "https://api.github.