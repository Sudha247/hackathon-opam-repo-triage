 \"https://mirage.github.io/irmin-watcher/\"\n+bug-reports: \"https://github.com/mirage/irmin-watcher/issues\"\n+depends: [\n+  \"dune\" {>= \"2.8\"}\n+  \"ocaml\" {>= \"5.2.0\"}\n+  \"alcotest\" {with-test}\n+  \"mtime\" {>= \"2.1.0\"}\n+  \"inotify\" {>= \"2.6\" & os = \"linux\"}\n+  \"inotify-eio\" {>= \"2.6\" & os = \"linux\"}\n+  \"cf-lwt\" {>= \"0.4\" & os = \"macos\"}\n+  \"lwt\" {os = \"macos\"}\n+  \"eio\" {>= \"1.6\"}\n+  \"optint\"\n+  \"eio_main\" {with-test & >= \"1.0\"}\n+  \"logs\"\n+  \"fmt\"\n+  \"astring\"\n+  \"fsevents-lwt\" {os = \"macos\"}\n+  \"lwt_eio\" {with-test | os = \"macos\"}\n+  \"odoc\" {with-doc}\n+]\n+build: [\n+  [\"dune\" \"subst\"] {dev}\n+  [\n+    \"dune\"\n+    \"build\"\n+    \"-p\"\n+    name\n+    \"-j\"\n+    jobs\n+    \"@install\"\n+    \"@runtest\" {with-test}\n+    \"@doc\" {with-doc}\n+  ]\n+]\n+dev-repo: \"git+https://github.com/mirage/irmin-watcher.git\"\n+url {\n+  src:\n+    \"https://github.com/mirage/irmin-watcher/releases/download/0.6.0/irmin-watcher-0.6.0.tbz\"\n+  checksum: [\n+    \"sha256=e2302bc0be07fe9cd644ad4ce7191460ea63aab4309f360df909fe19b24fa477\"\n+    \"sha512=f6e207511067ee89edcf68bb94deece027de57e9fb65ae60a6bc20642cf559a930278bacf5b9f41b5d3334734713aed86ea57a6247c8da9d86d961a3e304e794\"\n+  ]\n+}\n+x-commit-hash: \"c822643c77de97f25dc470a5a6f039b9801da715\""}, {"sha": "10509e74b0057a95e1d22f8943ef480d9de74c66", "filename": "packages/slipshow/slipshow.0.0.33/opam", "status": "modified", "additions": 1, "deletions": 1, "changes": 2, "blob_url": "https://github.com/ocaml/opam-repository/blob/79e6e2140ee3e82c58d607f1e294e74b3123089a/packages%2Fslipshow%2Fslipshow.0.0.33%2Fopam", "raw_url": "https://github.com/ocaml/opam-repository/raw/79e6e2140ee3e82c58d607f1e294e74b3123089a/packages%2Fslipshow%2Fslipshow.0.0.33%2Fopam", "contents_url": "https://api.github.com/repos/ocaml/opam-repository/contents/packages%2Fslipshow%2Fslipshow.0.0.33%2Fopam?ref=79e6e2140ee3e82c58d607f1e294e74b3123089a", "patch": "@@ 