sitory/commit/1c93acbc4176695001cc3356717dcfe90f89ce44"}]}], "files": [{"sha": "7781cbc4a44797727b46d4571dcd9c772df4aafa", "filename": "packages/chatoyant/chatoyant.0.18.0/opam", "status": "added", "additions": 67, "deletions": 0, "changes": 67, "blob_url": "https://github.com/ocaml/opam-repository/blob/8bd7f3b5699246c467c2698927e1a3e8e8f5b43d/packages%2Fchatoyant%2Fchatoyant.0.18.0%2Fopam", "raw_url": "https://github.com/ocaml/opam-repository/raw/8bd7f3b5699246c467c2698927e1a3e8e8f5b43d/packages%2Fchatoyant%2Fchatoyant.0.18.0%2Fopam", "contents_url": "https://api.github.com/repos/ocaml/opam-repository/contents/packages%2Fchatoyant%2Fchatoyant.0.18.0%2Fopam?ref=8bd7f3b5699246c467c2698927e1a3e8e8f5b43d", "patch": "@@ -0,0 +1,67 @@\n+opam-version: \"2.0\"\n+synopsis: \"OCaml-first LLM SDK with Melange-generated JavaScript\"\n+description:\n+  \"Chatoyant is an OCaml-first SDK for LLM providers. It exposes an Eio native API, typed JSON Schema and tool definitions, raw provider clients for OpenAI/Anthropic/xAI/Meta/OpenRouter/local inference, and a Melange-generated JavaScript package.\"\n+maintainer: [\"Anonyfox <max@anonyfox.com>\"]\n+authors: [\"Anonyfox <max@anonyfox.com>\"]\n+license: \"MIT\"\n+tags: [\n+  \"llm\"\n+  \"ai\"\n+  \"openai\"\n+  \"anthropic\"\n+  \"xai\"\n+  \"openrouter\"\n+  \"json-schema\"\n+  \"eio\"\n+  \"melange\"\n+  \"typesafe\"\n+]\n+homepage: \"https://github.com/Anonyfox/chatoyant\"\n+doc: \"https://anonyfox.github.io/chatoyant\"\n+bug-reports: \"https://github.com/Anonyfox/chatoyant/issues\"\n+depends: [\n+  \"ocaml\" {>= \"5.3\"}\n+  \"dune\" {>= \"3.23\"}\n+  \"melange\" {>= \"6.0.0\"}\n+  \"ca-certs\" {>= \"1.0.0\"}\n+  \"base64\"\n+  \"cohttp-eio\" {>= \"6.0.0\"}\n+  \"digestif\"\n+  \"domain-name\"\n+  \"eio\" {>= \"1.0\"}\n+  \"eio_main\" {with-test}\n+  \"http\" {>= \"6.0.0\"}\n+  \"mirage-crypto-rng\" {>= \"1.0.0\"}\n+  \"ppxlib\" {build}\n+  \"tls\" {>= \"1.0.0\"}\n+  \"tls-eio\" {>= \"1.0.0\"}\n+  \"uri\"\n+  \"x509\" {>= \"1.0.0\"}\n+  \"odoc\" {with-doc}\n+]\n+build: [\n+  [\"dune\" \"subst\"] {dev}\n+  [\n+    \"dune\"\n+    \"build\"\n+    \"-p\"\n+    name\n+    \"-j\"\n+    jobs\n+    \"@install\"\n+    \"@runtest\" {with-test}\n+    \"@doc\" {with-doc}\n+  ]\n+]\n+dev-repo: \"git+https://github.com/Anonyfox/chatoyant.git\"\n+x-maintenance-intent: [\"(latest)\"]\n+url {\n+  src:\n+    \"https://github.com/Anonyfox/chatoyant/releases/download/v0.18.0/chatoyant-v0.18.0.tbz\"\n+  checksum: [\n+    \"sha256=3c003dd1e14cfa4656de04ab97118dac151be5233df885eab5b09744584a745b\"\n+    \"sha512=510b59defbbf182697947937b33e3a3546ab5796a0962f1126d5fa8ec813ca891a655376853115676a40c72b1780b381603d7feca0a78f1f638e7535fec51686\"\n+  ]\n+}\n+x-commit-hash: \"70ce8f20e00a224fe96d7879548d3884b043d86d\""}]}