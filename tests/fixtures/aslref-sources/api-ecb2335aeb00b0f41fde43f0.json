at": null}}, "url": "https://api.github.com/repos/ocaml/opam-repository/commits/5a2833e2b7ed465175d6685cd3de0960d38cbabc", "html_url": "https://github.com/ocaml/opam-repository/commit/5a2833e2b7ed465175d6685cd3de0960d38cbabc", "comments_url": "https://api.github.com/repos/ocaml/opam-repository/commits/5a2833e2b7ed465175d6685cd3de0960d38cbabc/comments", "author": {"login": "psafont", "id": 5189409, "node_id": "MDQ6VXNlcjUxODk0MDk=", "avatar_url": "https://avatars.githubusercontent.com/u/5189409?v=4", "gravatar_id": "", "url": "https://api.github.com/users/psafont", "html_url": "https://github.com/psafont", "followers_url": "https://api.github.com/users/psafont/followers", "following_url": "https://api.github.com/users/psafont/following{/other_user}", "gists_url": "https://api.github.com/users/psafont/gists{/gist_id}", "starred_url": "https://api.github.com/users/psafont/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/psafont/subscriptions", "organizations_url": "https://api.github.com/users/psafont/orgs", "repos_url": "https://api.github.com/users/psafont/repos", "events_url": "https://api.github.com/users/psafont/events{/privacy}", "received_events_url": "https://api.github.com/users/psafont/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "committer": {"login": "psafont", "id": 5189409, "node_id": "MDQ6VXNlcjUxODk0MDk=", "avatar_url": "https://avatars.githubusercontent.com/u/5189409?v=4", "gravatar_id": "", "url": "https://api.github.com/users/psafont", "html_url": "https://github.com/psafont", "followers_url": "https://api.github.com/users/psafont/followers", "following_url": "https://api.github.com/users/psafont/following{/other_user}", "gists_url": "https://api.github.com/users/psafont/gists{/gist_id}", "starred_url": "https://api.github.com/users/psafont/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/psafont/subscriptions", "organizations_url": "https://api.github.com/users/psafont/orgs", "repos_url": "https://api.github.com/users/psafont/repos", "events_url": "https://api.github.com/users/psafont/events{/privacy}", "received_events_url": "https://api.github.com/users/psafont/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "parents": [{"sha": "8d8d144bbf0037c97e1725055be9fe32a0c526de", "url": "https://api.github.com/repos/ocaml/opam-repository/commits/8d8d144bbf0037c97e1725055be9fe32a0c526de", "html_url": "https://github.com/ocaml/opam-repository/commit/8d8d144bbf0037c97e1725055be9fe32a0c526de"}]}], "files": [{"sha": "c0f54ce4cd2cb24e6b60fd8474af963d6eac7084", "filename": "packages/aslref/aslref.ArmARM-M.d-concurrency/opam", "status": "added", "additions": 73, "deletions": 0, "changes": 73, "blob_url": "https://github.com/ocaml/opam-repository/blob/5a2833e2b7ed465175d6685cd3de0960d38cbabc/packages%2Faslref%2Faslref.ArmARM-M.d-concurrency%2Fopam", "raw_url": "https://github.com/ocaml/opam-repository/raw/5a2833e2b7ed465175d6685cd3de0960d38cbabc/packages%2Faslref%2Faslref.ArmARM-M.d-concurrency%2Fopam", "contents_url": "https://api.github.com/repos/ocaml/opam-repository/contents/packages%2Faslref%2Faslref.ArmARM-M.d-concurrency%2Fopam?ref=5a2833e2b7ed465175d6685cd3de0960d38cbabc", "patch": "@@ -0,0 +1,73 @@\n+opam-version: \"2.0\"\n+synopsis: \"Architecture Specification Language reference implementation\"\n+description: \"\"\"\n+\n+Arm's reference implementation and documentation for the Architecture\n+Specification Language (ASL).\n+\n+Provides parsing, type-checking, and interpretation of ASL, and other related\n+tooling.\n+\n+For more details, and for a downloadable version of the ASL language reference\n+document, please see\n+https://developer.arm.com/Architectures/Architecture%20Specification%20Language\n+\"\"\"\n+maintainer: [\"Arm Ltd - ATG Formal <atg-formal@arm.com>\"]\n+authors: [\"Arm Ltd - ATG Formal <atg-formal@arm.com>\"]\n+license: \"BSD-3-Clause\"\n+homepage: \"https://github.com/herd/herdtools7\"\n+doc:\n+  \"https://developer.arm.com/Architectures/Architecture%20Specification%20Language\"\n+bug-reports: \"https://github.com/herd/herdtools7/issues\"\n+depends: [\n+  \"ocaml\" {>= \"4.14\"}\n+  \"dune\" {>= \"3.14\" & >= \"3.14\"}\n+  \"menhir\" {>= \"20231231\"}\n+  \"zarith\" {>= \"1.13\"}\n+  \"yaml\" {>= \"3.2.0\" & with-test}\n+  \"odoc\" {with-doc}\n+]\n+depopts: [\n+  \"qcheck\" {with-test}\n+  \"ocamlformat\" {= \"0.28.1\" & with-dev-setup}\n+  \"zarith_stubs_js\"\n+  \"js_of_ocaml-ppx\"\n+]\n+build: [\n+  [\"dune\" \"subst\"] {dev}\n+  [\n+    \"dune\"\n+    \"build\"\n+    # cannot use -p while changing the root directory, so expand -p, while\n+    # changing the root\n+    \"--root\" \"asllib\" \"--ignore-promoted-rules\" \"--no-config\" \"--profile\"\n+    \"release\" \"--always-show-command-line\" \"--promote-install-files\"\n+    \"--require-dune-project-file\" \"--default-target\" \"@install\"\n+    \"--only-packages\"\n+    name\n+    \"-j\"\n+    jobs\n+    \"@install\"\n+    \"@runtest\" {with-test}\n+    \"@doc\" {with-doc}\n+  ]\n+]\n+\n+install: [\n+  [\"sh\" \"-c\" \"cd asllib && exec \\\"$@\\\"\" \"sh\"\n+   \"dune\" \"install\" \"-p\" name \"--prefix=%{prefix}%\"]\n+]\n+\n+dev-repo: \"git+https://github.com/herd/herdtools7.git\"\n+\n+# Make it available to opam, but don't install by default\n+flags: [avoid-version]\n+\n+url {\n+  src:\n+    \"https://github.com/herd/herdtools7/archive/refs/tags/ArmARM-M.d-concurrency.tar.gz\"\n+  checksum: [\n+    \"sha256=8d0faf7b0b0d2dba6a4c20717dbd759decaf02719fc51617c36304cdaf4e6e11\"\n+    \"sha512=69dbc166378a5aa48597ad692caf9386221656602e1e12e039c7445590259f3fc5eb26a877f6831775336abca6bc241e82f31723fd0e745b723e53147981974d\"\n+  ]\n+}"}, {"sha": "db7dec3f0c2b1f5e75067ecd74d4c31669cc972d", "filename": "packages/herdtools7/herdtools7.ArmARM-M.d-concurrency/opam", "status": "added", "additions": 40, "deletions": 0, "changes": 40, "blob_url": "https://github.com/ocaml/opam-repository/blob/5a2833e2b7ed465175d6685cd3de0960d38cbabc/packages%2Fherdtools7%2Fherdtools7.ArmARM-M.d-concurrency%2Fopam", "raw_url": "https://github.com/ocaml/opam-repository/raw/5a2833e2b7ed465175d6685cd3de0960d38cbabc/packages%2Fherdtools7%2Fherdtools7.ArmARM-M.d-concurrency%2Fopam", "contents_url": "https://api.github.com/repos/ocaml/opam-repository/contents/packages%2Fherdtools7%2Fherdtools7.ArmARM-M.d-concurrency%2Fopam?ref=5a2833e2b7ed465175d6685cd3de0960d38cbabc", "patch": "@@ -0,0 +1,40 @@\n+opam-version: \"2.0\"\n+synopsis: \"The herdtools suite for simulating and studying weak memory models\"\n+maintainer: \"Luc Maranget <Luc.Maranget@inria.fr>\"\n+authors: [\n+  \"Luc Maranget <Luc.Maranget@inria.fr>\"\n+  \"Jade Alglave <j.alglave@ucl.ac.uk>\"\n+]\n+homepage: \"http://diy.inria.fr/\"\n+bug-reports: \"http://github.com/herd/herdtools7/issues/\"\n+doc: \"http://diy.inria.fr/doc/index.html\"\n+dev-repo: \"git+https://github.com/herd/herdtools7.git\"\n+license: \"CECILL-B\"\n+build: [make \"build-release\" \"PREFIX=%{prefix}%\"]\n+install: [make \"install-herdtools\" \"PREFIX=%{prefix}%\"]\n+# @todo Add \"build-doc\" field\n+# @todo Add \"build-test\" field\n+depends: [\n+  \"ocaml\" {>= \"4.14.0\"}\n+  \"dune\"  {>= \"3.14.0\" }\n+  \"menhir\" {>= \"20231231\"}\n+  \"zarith\" {>= \"1.13\"}\n+  \"conf-which\"\n+  \"logs\"\n+  \"aslref\" {= version}\n+  \"conf-python-3\" {>= \"9.0.0\" & with-test}\n+  \"conf-gcc\" {with-test}\n+]\n+conflicts: [\"ocaml-option-bytecode-only\"]\n+\n+# Make it available to opam, but don't install by default\n+flags: [avoid-version]\n+\n+url {\n+  src:\n+    \"https://github.com/herd/herdtools7/archive/refs/tags/ArmARM-M.d-concurrency.tar.gz\"\n+  checksum: [\n+    \"sha256=8d0faf7b0b0d2dba6a4c20717dbd759decaf02719fc51617c36304cdaf4e6e11\"\n+    \"sha512=69dbc166378a5aa48597ad692caf9386221656602e1e12e039c7445590259f3fc5eb26a877f6831775336abca6bc241e82f31723fd0e745b723e53147981974d\"\n+  ]\n+}"}]}