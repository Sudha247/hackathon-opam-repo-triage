": "public", "site_admin": false}, "parents": [{"sha": "c9b3c165b067f33b75dbeae72122d296a5b2f778", "url": "https://api.github.com/repos/ocaml/opam-repository/commits/c9b3c165b067f33b75dbeae72122d296a5b2f778", "html_url": "https://github.com/ocaml/opam-repository/commit/c9b3c165b067f33b75dbeae72122d296a5b2f778"}, {"sha": "52f56924933eca848941947a9c88a30998c8e57e", "url": "https://api.github.com/repos/ocaml/opam-repository/commits/52f56924933eca848941947a9c88a30998c8e57e", "html_url": "https://github.com/ocaml/opam-repository/commit/52f56924933eca848941947a9c88a30998c8e57e"}]}, "status": "diverged", "ahead_by": 1, "behind_by": 13, "total_commits": 1, "commits": [{"sha": "ab3adebc3709da97cafdc3546a50c8158b229dcd", "node_id": "C_kwDOAETL7doAKGFiM2FkZWJjMzcwOWRhOTdjYWZkYzM1NDZhNTBjODE1OGIyMjlkY2Q", "commit": {"author": {"name": "Thomas Gazagnaire", "email": "thomas@gazagnaire.org", "date": "2026-11-10T20:36:01Z"}, "committer": {"name": "Thomas Gazagnaire", "email": "thomas@gazagnaire.org", "date": "2026-11-10T22:49:15Z"}, "message": "pg_query, ocaml-r, ahrocksdb: accept CI failures with newer system libraries\n\nThese old releases do not build against the C libraries of recent\ndistributions.\n\npg_query.0.9.7 fails with glibc >= 2.38, which now declares `strchrnul`\n(pganalyze/libpg_query#203). Fixed in 0.9.8\n(roddyyaga/pg_query-ocaml#17):\n\n```\nsrc/postgres/src_port_snprintf.c:374:1: error: conflicting types for 'strchrnul'; have 'const char *(const char *, int)'\n/usr/include/string.h:286:14: note: previous declaration of 'strchrnul' with type 'char *(const char *, int)'\n```\n\nocaml-r.0.4.0 and 0.5.0 fail with R >= 4.2.0, whose `Rinternals.h` no\nlonger defines `struct SEXPREC`, even with `USE_RINTERNALS`. 0.6.0 removed\nthese accessors:\n\n```\nread_internal_stub.c:108:32: error: invalid use of undefined type 'struct SEXPREC'\n```\n\nahrocksdb.0.2.0 to 0.2.2 fail with RocksDB >= 6.19, whose `version.h`\nincludes `<string>` (facebook/rocksdb@0a9a05ae), while\n`ffi/lib/config/discover.ml` compiles its probe as C. Fixed upstream in\nahrefs/ocaml-ahrocksdb#5, which is not released in opam:\n\n```\n | /usr/include/rocksdb/version.h:7:10: fatal error: string: No such file or directory\nError: discover error\n```", "tree": {"sha": "7c775bfe4f349640e52e879d0d7da3e5d138b395", "url": "https://api.github.com/repos/ocaml/opam-repository/git/trees/7c775bfe4f349640e52e879d0d7da3e5d138b395"}, "url": "https://api.github.com/repos/ocaml/opam-repository/git/commits/ab3adebc3709da97cafdc3546a50c8158b229dcd", "comment_count": 0, "verification": {"verified": false, "reason": "unsigned", "signature": null, "payload": null, "verified_at": null}}, "url": "https://api.github.com/repos/ocaml/opam-repository/commits/ab3adebc3709da97cafdc3546a50c8158b229dcd", "html_url": "https://github.com/ocaml/opam-repository/commit/ab3adebc3709da97cafdc3546a50c8158b229dcd", "comments_url": "https://api.github.com/repos/ocaml/opam-repository/commits/ab3adebc3709da97cafdc3546a50c8158b229dcd/comments", "author": {"login": "samoht", "id": 103693, "node_id": "MDQ6VXNlcjEwMzY5Mw==", "avatar_url": "https://avatars.githubusercontent.com/u/103693?v=4", "gravatar_id": "", "url": "https://api.github.com/users/samoht", "html_url": "https://github.com/samoht", "followers_url": "https://api.github.com/users/samoht/followers", "following_url": "https://api.github.com/users/samoht/following{/other_user}", "gists_url": "https://api.github.com/users/samoht/gists{/gist_id}", "starred_url": "https://api.github.com/users/samoht/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/samoht/subscriptions", "organizations_url": "https://api.github.com/users/samoht/orgs", "repos_url": "https://api.github.com/users/samoht/repos", "events_url": "https://api.github.com/users/samoht/events{/privacy}", "received_events_url": "https://api.github.com/users/samoht/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "committer": {"login": "samo