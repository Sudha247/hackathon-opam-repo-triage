pt-in basis.\n\n\n\n---\n* Homepage: https://github.com/ocsigen/lwt\n* Source repo: git+https://github.com/ocsigen/lwt.git\n* Bug tracker: https://github.com/ocsigen/lwt/issues\n\n---\n:camel: Pull-request generated by opam-publish v2.5.1", "created_at": "2026-04-20T14:06:44Z", "updated_at": "2026-04-29T00:32:03Z", "closed_at": "2026-04-29T00:32:03Z", "merged_at": "2026-04-29T00:32:03Z", "merge_commit_sha": "dd592986d47d277a9eee2bf37e1c4aa3a0c3efbd", "assignees": [], "requested_reviewers": [], "requested_teams": [], "labels": [{"id": 639034286, "node_id": "MDU6TGFiZWw2MzkwMzQyODY=", "url": "https://api.github.com/repos/ocaml/opam-repository/labels/needs%20reporter%20action", "name": "needs reporter action", "color": "c2e0c6", "default": false, "description": null, "archived_at": null, "archived_by": null}], "milestone": null, "draft": false, "commits_url": "https://api.github.com/repos/ocaml/opam-repository/pulls/29752/commits", "review_comments_url": "https://api.github.com/repos/ocaml/opam-repository/pulls/29752/comments", "review_comment_url": "https://api.github.com/repos/ocaml/opam-repository/pulls/comments{/number}", "comments_url": "https://api.github.com/repos/ocaml/opam-repository/issues/29752/comments", "statuses_url": "https://api.github.com/repos/ocaml/opam-repository/statuses/7645f97b586277a16cf333df0a5548bdfba43106", "head": {"label": "raphael-proust:opam-publish-lwt.6.1.2", "ref": "opam-publish-lwt.6.1.2", "sha": "7645f97b586277a16cf333df0a5548bdfba43106", "user": {"login": "raphael-proust", "id": 656181, "node_id": "MDQ6VXNlcjY1NjE4MQ==", "avatar_url": "https://avatars.githubusercontent.com/u/656181?v=4", "gravatar_id": "", "url": "https://api.github.com/users/raphael-proust", "html_url": "https://github.com/raphael-proust", "followers_url": "https://api.github.com/users/raphael-proust/followers", "following_url": "https://api.github.com/users/raphael-proust/following{/other_user}", "gists_url": "https://api.github.com/users/raphael-proust/gists{/gis