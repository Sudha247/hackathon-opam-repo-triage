[{"url": "https://api.github.com/repos/ocaml/opam-repository/pulls/28178", "id": 2670450361, "node_id": "PR_kwDOAETL7c6fK9a5", "html_url": "https://github.com/ocaml/opam-repository/pull/28178", "diff_url": "https://github.com/ocaml/opam-repository/pull/28178.diff", "patch_url": "https://github.com/ocaml/opam-repository/pull/28178.patch", "issue_url": "https://api.github.com/repos/ocaml/opam-repository/issues/28178", "number": 28178, "state": "closed", "locked": false, "title": "[new release] lambdapi (3.0.0)", "user": {"login": "fblanqui", "id": 10852505, "node_id": "MDQ6VXNlcjEwODUyNTA1", "avatar_url": "https://avatars.githubusercontent.com/u/10852505?v=4", "gravatar_id": "", "url": "https://api.github.com/users/fblanqui", "html_url": "https://github.com/fblanqui", "followers_url": "https://api.github.com/users/fblanqui/followers", "following_url": "https://api.github.com/users/fblanqui/following{/other_user}", "gists_url": "https://api.github.com/users/fblanqui/gists{/gist_id}", "starred_url": "https://api.github.com/users/fblanqui/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/fblanqui/subscriptions", "organizations_url": "https://api.github.com/users/fblanqui/orgs", "repos_url": "https://api.github.com/users/fblanqui/repos", "events_url": "https://api.github.com/users/fblanqui/events{/privacy}", "received_events_url": "https://api.github.com/users/fblanqui/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "body": "Proof assistant for the \u03bb\u03a0-calculus modulo rewriting\n\n- Project page: <a href=\"https://github.com/Deducteam/lambdapi\">https://github.com/Deducteam/lambdapi</a>\n\n##### CHANGES:\n\n### Added\n\n- Tactic `simplify rule off` to simplify the focused goal wrt \u03b2-reduction only.\n- Tacticals `orelse` and `repeat`.\n- Tactic `eval` which evaluates a term and interprets it as a tactic. This allows one to define tactics using rewriting.\n- Builtin `\"String\"` for string literals between double quotes.\n- Options `--header` and `--url` for the `websearch` command.\n- In search queries, replace the substring `\"forall\"` and `\"->\"` by `\"\u03a0\"` and `\"\u2192\"` respectively.\n- Websearch queries and responses are now recorded in the log.\n- Commands `debug` and `flag` with no argument to get the list of debug flags and the list of flags respectively.\n- Tactic `change`.\n- Modifier `private` for `open` command to not be exported.\n\n### Changed\n\n- Replaced Bindlib by de Bruijn (Fr\u00e9d\u00e9ric) and closures (Bruno). The performances are slightly better than with Bindlib, especially on rewriting intensive files (the new version is 3.7 times faster on `tests/OK/perf_rw_engine.lp`). Lambdapi is now 2 times faster than dkcheck on matita, and only 2 times slower than dkcheck on holide.\n- Several improvements to use the search engine:\n  * normalize queries in websearch/search\n  * pre-load a file in websearch (e.g. to declare implicit args)\n  * paginate the output in the generated webpage\n  * allow to declare rewriting rules (e.g. alignments) over defined and constant symbols\n  * improve error message for overloaded symbols\n- Tactic set x \u2254 t: replace all subterms equal to t by x.\n- Enhance the formatting of the search results.\n- `require` and `open` are now recursive.\n\n### Fixed\n\n- Notations on external symbols are now exported.\n- Make the websearch server listen on all the interfaces instead of localhost only.\n", "created_at": "2025-07-16T11:57:33Z", "updated_at": "2025-10-15T15:55:43Z", "closed_at": "2025-07-21T04:12:52Z", "merged_at": "2025-07-21T04:12:51Z", "merge_commit_sha": "c1b29bb356bf4697406716ebb498ac0f4e4289d6", "assignees": [], "requested_reviewers": [], "requested_teams": [], "labels": [], "milestone": null, "draft": false, "commits_url": "https://api.github.com/repos/ocaml/opam-repository/pulls/28178/commits", "review_comments_url": "https://api.github.com/repos/ocaml/opam-repository/pulls/28178/comments