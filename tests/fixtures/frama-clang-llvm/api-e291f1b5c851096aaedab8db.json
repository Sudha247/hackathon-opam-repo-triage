72709f3f96547c213538893a37bcd46c12572e0e", "html_url": "https://github.com/ocaml/opam-repository/commit/72709f3f96547c213538893a37bcd46c12572e0e"}]}], "files": [{"sha": "ace863417147fd3ec08a320363a820758526a8cb", "filename": "packages/frama-clang/frama-clang.0.0.21~beta/opam", "status": "added", "additions": 50, "deletions": 0, "changes": 50, "blob_url": "https://github.com/ocaml/opam-repository/blob/8f970cb1aaa9971525c904c59e168a4ab5169d00/packages%2Fframa-clang%2Fframa-clang.0.0.21%7Ebeta%2Fopam", "raw_url": "https://github.com/ocaml/opam-repository/raw/8f970cb1aaa9971525c904c59e168a4ab5169d00/packages%2Fframa-clang%2Fframa-clang.0.0.21%7Ebeta%2Fopam", "contents_url": "https://api.github.com/repos/ocaml/opam-repository/contents/packages%2Fframa-clang%2Fframa-clang.0.0.21%7Ebeta%2Fopam?ref=8f970cb1aaa9971525c904c59e168a4ab5169d00", "patch": "@@ -0,0 +1,50 @@\n+opam-version: \"2.0\"\n+synopsis: \"Frama-C plug-in based on Clang for parsing C++ files\"\n+description:\n+  \"This Frama-C plug-in parse C++ files that may contain ACSL++ annotations.\"\n+maintainer: \"Virgile.Prevosto@cea.fr\"\n+authors: \"Virgile Prevosto\"\n+license: \"LGPL-2.1-only\"\n+tags: [\"formal specification\" \"C++\" \"plugins\" \"ACSL\" \"ACSL++\"]\n+homepage: \"https://frama-c.com/frama-clang.html\"\n+bug-reports: \"https://git.frama-c.com/pub/frama-clang/-/issues\"\n+depends: [\n+  \"dune\" {>= \"3.15\"}\n+  \"frama-c\" {>= \"34.0~\" & < \"35.0~\"}\n+  \"zarith\" {>= \"1.5\"}\n+  \"camlp-streams\"\n+  \"conf-libclang\" {= \"22\"}\n+  \"conf-clang\" {os-family = \"debian\" | os-family = \"ubuntu\"}\n+  \"conf-cmake\"\n+  \"odoc\" {with-doc}\n+]\n+build: [\n+  [\"dune\" \"subst\"] {dev}\n+  [\n+    \"env\"\n+    \"OPAM_LLVM_CONFIG=%{conf-libclang:config}%\"\n+    \"FCIRGEN_JOBS=%{jobs}%\"\n+    \"dune\"\n+    \"build\"\n+    \"-p\"\n+    name\n+    \"-j\"\n+    jobs\n+    \"--promote-install-files=false\"\n+    \"@install\"\n+    \"@runtest\" {with-test}\n+    \"@doc\" {with-doc}\n+  ]\n+  [\"dune\" \"install\" \"-p\" name \"--create-install-files\" name]\n+]\n+dev-repo: \"git+https://git.frama-c.com/pub/frama-clang.git\"\n+url {\n+  src:\n+    \"https://git.frama-c.com/pub/frama-clang/-/archive/0.0.21-beta/frama-clang-0.0.21-beta.tar.bz2\"\n+  checksum: [\n+    \"md5=37ec0f3e62ee9ba98eb0a8f7a178e13f\"\n+    \"sha512=7120c781e44a220b1c6fda2a6a799548e84ea4bc1e1c2173d8993ec6e308b889b7827e0fcc78cca75f1d8c18a2d2de72e3c7f273a7a6aff83af4ef1826f809c3\"\n+  ]\n+}\n+x-ci-accept-failures: [\"debian-11\" \"ubuntu-20.04\" \"freebsd-14.3\"]\n+x-maintenance-intent: [\"(latest)\" \"(latest-1)\"]"}]}