[{"sha": "c69b55fe4b4bd0db276c25b14723ecc3ef037291", "node_id": "C_kwDOAETL7doAKGM2OWI1NWZlNGI0YmQwZGIyNzZjMjViMTQ3MjNlY2MzZWYwMzcyOTE", "commit": {"author": {"name": "Samuel Hym", "email": "samuel@tarides.com", "date": "2026-07-06T16:44:30Z"}, "committer": {"name": "Samuel Hym", "email": "samuel@tarides.com", "date": "2026-07-06T16:44:30Z"}, "message": "Release OCaml/Unikraft 1.2.0\n\nMain changes in OCaml/Unikraft:\n\n- Support for OCaml 5.4.1 and 5.5.0\n- Build a relocatable cross compiler with OCaml 5.5.0 (but note that the\n  ocamlfind toolchain description always contains absolute paths)\n- Add an option to support the 9pfs filesystem\n- Add support for custom Unikraft configurations\n- Apply patches, when required, using `opatch` for portability\n- Increase the default stack size as OCaml application really commonly\n  need more than just 64KB\n\nChanges in the packaging:\n\n- Use tighter dependencies to prevent untested combinations\n- Adopt the OCaml/Unikraft version (1.2.0) also for the backend\n  packages, combining it with the Unikraft version (ending up with\n  version numbers 1.2.0-0.20.0), following the scheme used by Merlin", "tree": {"sha": "77f314ff54e770ce5e3aa81faa586e5550e82761", "url": "https://api.github.com/repos/ocaml/opam-repository/git/trees/77f314ff54e770ce5e3aa81faa586e5550e82761"}, "url": "https://api.github.com/repos/ocaml/opam-repository/git/commits/c69b55fe4b4bd0db276c25b14723ecc3ef037291", "comment_count": 0, "verification": {"verified": false, "reason": "unsigned", "signature": null, "payload": null, "verified_at": null}}, "url": "https://api.github.com/repos/ocaml/opam-repository/commits/c69b55fe4b4bd0db276c25b14723ecc3ef037291", "html_url": "https://github.com/ocaml/opam-repository/commit/c69b55fe4b4bd0db276c25b14723ecc3ef037291", "comments_url": "https://api.github.com/repos/ocaml/opam-repository/commits/c69b55fe4b4bd0db276c25b14723ecc3ef037291/comments", "author": {"login": "shym", "id": 547679, "node_id": "MDQ6VXNlcjU0NzY3OQ==