m/users/tbrk/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "parents": [{"sha": "2aed95b093c97857aa873e1e949e712f397f6fa7", "url": "https://api.github.com/repos/ocaml/opam-repository/commits/2aed95b093c97857aa873e1e949e712f397f6fa7", "html_url": "https://github.com/ocaml/opam-repository/commit/2aed95b093c97857aa873e1e949e712f397f6fa7"}]}], "files": [{"sha": "96c5944d7f2472de7b8fd364a78b1c16940ac575", "filename": "packages/ortools/ortools.9.15.0-3/opam", "status": "added", "additions": 54, "deletions": 0, "changes": 54, "blob_url": "https://github.com/ocaml/opam-repository/blob/55ad97d637d37d80b5d186bd7b3850ad263d05f1/packages%2Fortools%2Fortools.9.15.0-3%2Fopam", "raw_url": "https://github.com/ocaml/opam-repository/raw/55ad97d637d37d80b5d186bd7b3850ad263d05f1/packages%2Fortools%2Fortools.9.15.0-3%2Fopam", "contents_url": "https://api.github.com/repos/ocaml/opam-repository/contents/packages%2Fortools%2Fortools.9.15.0-3%2Fopam?ref=55ad97d637d37d80b5d186bd7b3850ad263d05f1", "patch": "@@ -0,0 +1,54 @@\n+opam-version: \"2.0\"\n+\n+synopsis:\n+\"Build and export Google OR-Tools models\"\n+\n+description: \"\"\"\n+Google OR-Tools is an open source software suite for optimization, tuned\n+for tackling the world's toughest problems in vehicle routing, flows,\n+integer and linear programming, and constraint programming. This package\n+provides OCaml functions for working with the Protocol Buffer formats that\n+are read and written by the different solvers. It does not actually depend\n+on the OR-Tools software, which need not even be installed. The interface\n+currently only supports a subset of the features provided by the CP-SAT solver.\n+Pull requests for more features and solvers are welcome.\"\"\"\n+\n+maintainer:  [\"Timothy Bourke <tim@tbrk.org>\"]\n+authors:     [\"Timothy Bourke <tim@tbrk.org>\"]\n+license:     \"Apache-2.0\"\n+homepage:    \"https://github.com/inria/ocaml-ortools\"\n+bug-reports: \"https://github.com/inria/ocaml-ortools/issues\"\n+dev-repo:    \"git+https://github.com/inria/ocaml-ortools.git\"\n+x-maintenance-intent: [\"(latest)\"]\n+\n+depends: [\n+  \"ocaml\"\t{>= \"4.14.2\"}\n+  \"dune\"\t{>= \"3.21\"}\n+  \"pbrt\"\t{>= \"4.0\"}\n+  \"odoc\"\t{with-doc}\n+]\n+\n+build: [\n+  [\"dune\" \"subst\"] {dev}\n+  [\n+    \"dune\"\n+    \"build\"\n+    \"-p\"\n+    name\n+    \"-j\"\n+    jobs\n+    \"@install\"\n+    \"@runtest\" {with-test}\n+    \"@doc\" {with-doc}\n+  ]\n+]\n+url {\n+  src:\n+    \"https://github.com/INRIA/ocaml-ortools/releases/download/9.15.0-3/ortools-9.15.0-3.tbz\"\n+  checksum: [\n+    \"sha256=2dfa5a221f07e7756afda6f23d066aae8ebb73254e201a44921f24e0491c5f7b\"\n+    \"sha512=be451a999703a032444c632e0c87b4e391449cee0daa9f4837b0798fc7b8b1ce10abf7bc11dc7439a381a9281a7fb02b9239c75c3df0e4e70d2c690eeb8ae78c\"\n+  ]\n+}\n+x-commit-hash: \"ca8e169a33b45f90c591a98a84cf6ef9a8527a8e\"\n+"}, {"sha": "e472e5a13feb58a27b33f7dad86eb138772bfa4a", "filename": "packages/ortools_solvers/ortools_solvers.9.15.0-3/opam", "status": "added", "additions": 80, "deletions": 0, "changes": 80, "blob_url": "https://github.com/ocaml/opam-repository/blob/55ad97d637d37d80b5d186bd7b3850ad263d05f1/packages%2Fortools_solvers%2Fortools_solvers.9.15.0-3%2Fopam", "raw_url": "https://github.com/ocaml/opam-repository/raw/55ad97d637d37d80b5d186bd7b3850ad263d05f1/packages%2Fortools_solvers%2Fortools_solvers.9.15.0-3%2Fopam", "contents_url": "https://api.github.com/repos/ocaml/opam-repository/contents/packages%2Fortools_solvers%2Fortools_solvers.9.15.0-3%2Fopam?ref=55ad97d637d37d80b5d186bd7b3850ad263d05f1", "patch": "@@ -0,0 +1,80 @@\n+opam-version: \"2.0\"\n+\n+synopsis:\n+\"Call Google OR-Tools solvers\"\n+\n+description: \"\"\"\n+Google OR-Tools is an open source software suite for optimization, tuned\n+for tackling the world's toughest problems in vehicle routing, flows,\n+integer and linear programming, and constraint programming. This package\n+provides OCaml wrappers for calling the OR-Tools solvers. It currently only\n+supports the CP-SAT solver. Pull requests for other solvers are welcome.\"\"\"\n+\n+maintainer:  [\"Timothy Bourke <tim@tbrk.org>\"]\n+authors:     [\"Timothy Bourke <tim@tbrk.org>\"]\n+license:     \"Apache-2.0\"\n+homepage:    \"https://github.com/inria/ocaml-ortools\"\n+bug-reports: \"https://github.com/inria/ocaml-ortools/issues\"\n+dev-repo:    \"git+https://github.com/inria/ocaml-ortools.git\"\n+x-maintenance-intent: [\"(latest)\"]\n+\n+depends: [\n+  \"ocaml\"\t{>= \"4.14.2\"}\n+  \"dune\"\t{>= \"3.21\"}\n+  \"ortools\"\t{>= \"9.15\"}\n+  \"conf-cmake\"\t{build}\n+  \"sexplib0\"\t{build}\n+  \"csexp\"\t{build}\n+  \"odoc\"\t{with-doc}\n+  \"conf-zlib\"\n+  \"conf-bzip2\"\n+]\n+\n+build: [\n+  [\"dune\" \"subst\"] {dev}\n+  [\n+    \"dune\"\n+    \"build\"\n+    \"-p\"\n+    name\n+    \"-j\"\n+    jobs\n+    \"@install\"\n+    \"@runtest\" {with-test}\n+    \"@doc\" {with-doc}\n+  ]\n+]\n+\n+depexts: [\n+  # debian, alpine, arch: build with OCaml ortools_solvers package\n+\n+  # needed to compile abseil (linux/futex.h)\n+  [\"linux-headers\"]\t    {os-distribution = \"alpine\"}\n+]\n+\n+x-ci-accept-failures: [\n+  \"centos-9\"\t\t# c++ compilation fails\n+  \"opensuse-15.6\"\t# cannot compile with cmake\n+  \"opensuse-16.0\"\t# zlib-devel conflicts with zlib-ng-compat-devel\n+\t\t\t# and the zlib-ng-compat-devel cmake files are wrong\n+  \"opensuse-tumbleweed\"\t# zlib-devel conflicts with zlib-ng-compat-devel\n+\t\t\t# and the zlib-ng-compat-devel cmake files are wrong\n+]\n+\n+post-messages: [\n+  \"\"\"Failed to install ortools_solvers.\n+Ensure the required dependencies are properly installed.\n+See https://github.com/inria/ocaml-ortools.\n+\"\"\"\n+  {failure}\n+]\n+url {\n+  src:\n+    \"https://github.com/INRIA/ocaml-ortools/releases/download/9.15.0-3/ortools-9.15.0-3.tbz\"\n+  checksum: [\n+    \"sha256=2dfa5a221f07e7756afda6f23d066aae8ebb73254e201a44921f24e0491c5f7b\"\n+    \"sha512=be451a999703a032444c632e0c87b4e391449cee0daa9f4837b0798fc7b8b1ce10abf7bc11dc7439a381a9281a7fb02b9239c75c3df0e4e70d2c690eeb8ae78c\"\n+  ]\n+}\n+x-commit-hash: \"ca8e169a33b45f90c591a98a84cf6ef9a8527a8e\"\n+"}]}