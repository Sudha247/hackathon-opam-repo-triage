"sha": "afc86549a0f45d591ee7b1397e9c9aedce9da097", "url": "https://api.github.com/repos/ocaml/opam-repository/commits/afc86549a0f45d591ee7b1397e9c9aedce9da097", "html_url": "https://github.com/ocaml/opam-repository/commit/afc86549a0f45d591ee7b1397e9c9aedce9da097"}, {"sha": "1188df79f2556fdf38b5595ed1214b0ed608f275", "url": "https://api.github.com/repos/ocaml/opam-repository/commits/1188df79f2556fdf38b5595ed1214b0ed608f275", "html_url": "https://github.com/ocaml/opam-repository/commit/1188df79f2556fdf38b5595ed1214b0ed608f275"}]}, "status": "ahead", "ahead_by": 1, "behind_by": 0, "total_commits": 1, "commits": [{"sha": "55ad97d637d37d80b5d186bd7b3850ad263d05f1", "node_id": "C_kwDOAETL7doAKDU1YWQ5N2Q2MzdkMzdkODBiNWQxODZiZDdiMzg1MGFkMjYzZDA1ZjE", "commit": {"author": {"name": "Timothy Bourke", "email": "tim@tbrk.org", "date": "2026-10-11T19:22:00Z"}, "committer": {"name": "Timothy Bourke", "email": "tim@tbrk.org", "date": "2026-10-11T19:22:00Z"}, "message": "[new release] ortools (2 packages) (9.15.0-3)\n\nCHANGES:\n\nMacOS: build all required libraries (abseil, re2, protobuf, protobuf-c)\nrather than rely on brew-installed external dependencies to avoid build\nfailures after the recent update of Abseil to 20260817. The other external\nlibraries all require a consistent version of Abseil. This change increases\nthe build time but also its robustness to changes in the build environment,\ni.e., to changes in the packages install with homebrew.", "tree": {"sha": "87459c1bf1121d2b29405698370e39503b631ce1", "url": "https://api.github.com/repos/ocaml/opam-repository/git/trees/87459c1bf1121d2b29405698370e39503b631ce1"}, "url": "https://api.github.com/repos/ocaml/opam-repository/git/commits/55ad97d637d37d80b5d186bd7b3850ad263d05f1", "comment_count": 0, "verification": {"verified": false, "reason": "unsigned", "signature": null, "payload": null, "verified_at": null}}, "url": "https://api.github.com/repos/ocaml/opam-repository/commits/55ad97d637d37d80b5d186bd7b3850ad263d05f1", "h