": "added", "additions": 58, "deletions": 0, "changes": 58, "blob_url": "https://github.com/ocaml/opam-repository/blob/00f688e6e6e43a9d4720c3fbf49df8f262e6f232/packages%2Fwhy3find%2Fwhy3find.1.3.1%2Fopam", "raw_url": "https://github.com/ocaml/opam-repository/raw/00f688e6e6e43a9d4720c3fbf49df8f262e6f232/packages%2Fwhy3find%2Fwhy3find.1.3.1%2Fopam", "contents_url": "https://api.github.com/repos/ocaml/opam-repository/contents/packages%2Fwhy3find%2Fwhy3find.1.3.1%2Fopam?ref=00f688e6e6e43a9d4720c3fbf49df8f262e6f232", "patch": "@@ -0,0 +1,58 @@\n+opam-version: \"2.0\"\n+synopsis: \"A Why3 Package Manager\"\n+description:\n+  \"The why3find utility is designed for managing packages for why3 developers and associated OCaml extracted code.\"\n+maintainer: [\"benjamin.jorge@cea.fr\" \"loic.correnson@cea.fr\"]\n+authors: [\n+  \"Lo\u00efc Correnson <loic.correnson@cea.fr>\"\n+  \"Benjamin Jorge <benjamin.jorge@cea.fr>\"\n+]\n+license: \"LGPL-2.1-only\"\n+tags: \"why3\"\n+homepage: \"https://git.frama-c.com/pub/why3find\"\n+doc: \"https://git.frama-c.com/pub/why3find\"\n+bug-reports: \"https://git.frama-c.com/pub/why3find/issues\"\n+depends: [\n+  \"dune\" {>= \"3.12\"}\n+  \"cpu\"\n+  \"xdg\"\n+  \"dune-site\" {>= \"3.4\"}\n+  \"why3\" {>= \"1.8.0\"}\n+  \"ocaml\" {>= \"5.2.0\"}\n+  \"yojson\" {>= \"1.7.0\"}\n+  \"terminal_size\" {>= \"0.2.0\"}\n+  \"zmq\" {with-test}\n+  \"alt-ergo\" {with-test & = \"2.4.2\"}\n+  \"ocp-indent\" {with-test & = \"1.9.0\"}\n+  \"headache\" {with-test & = \"1.08\"}\n+  \"odoc\" {with-doc}\n+]\n+depopts: [\n+  \"zmq\" {>= \"5.0.0\"}\n+]\n+build: [\n+  [\"dune\" \"subst\"] {dev}\n+  [\n+    \"dune\"\n+    \"build\"\n+    \"-p\"\n+    name\n+    \"-j\"\n+    jobs\n+    \"--promote-install-files=false\"\n+    \"@install\"\n+    \"@runtest\" {with-test}\n+    \"@doc\" {with-doc}\n+  ]\n+  [\"dune\" \"install\" \"-p\" name \"--create-install-files\" name]\n+]\n+dev-repo: \"git+https://git.frama-c.com/pub/why3find.git\"\n+x-maintenance-intent: [\"(latest)\"]\n+url {\n+  src:\n+    \"https://git.frama-c.com/pub/why3find/-/archive/1.3.1/why3find-1.3.1.tar.gz\"\n+  checksum: [\n+    \"md5=e03191057b0fa05b84f9d89e445f9493\"\n+    \"sha512=d19f5c43c46149a272488427b973f067503e59842ce4b828677d820fb154443db566ef24973265b2acc100a143d1f4a8ede7d83350c415de2b3c4ef8e792b74b\"\n+  ]\n+}"}]}